function AbyssModelViewer() {
  const viewerRef = useRef(null);
  const [progress, setProgress] = useState(0);
  const [isLoaded, setIsLoaded] = useState(false);

  // Inietta lo script di model-viewer dinamicamente per evitare blocchi al caricamento
  useEffect(() => {
    if (!customElements.get('model-viewer')) {
      const script = document.createElement('script');
      script.type = 'module';
      script.src = 'https://ajax.googleapis.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js';
      document.head.appendChild(script);
    }
  }, []);

  // Gestione esplicita degli eventi di caricamento per evitare blocchi della UI
  useEffect(() => {
    const viewer = viewerRef.current;
    if (!viewer) return;

    const handleProgress = (event) => {
      // event.detail.totalProgress va da 0 a 1
      const currentProgress = Math.round(event.detail.totalProgress * 100);
      setProgress(currentProgress);
      if (currentProgress >= 100) {
        setIsLoaded(true);
      }
    };

    const handleLoad = () => {
      setIsLoaded(true);
    };

    viewer.addEventListener('progress', handleProgress);
    viewer.addEventListener('load', handleLoad);

    // Timeout di sicurezza: forza la rimozione del loader se l'evento si perde
    const safetyTimeout = setTimeout(() => {
      setIsLoaded(true);
    }, 15000); // 15 secondi max

    return () => {
      viewer.removeEventListener('progress', handleProgress);
      viewer.removeEventListener('load', handleLoad);
      clearTimeout(safetyTimeout);
    };
  }, []);

  return (
    <div className="relative w-full h-full flex items-center justify-center">
      {/* UI personalizzata di caricamento gestita da React */}
      {!isLoaded && (
        <div className="absolute inset-0 flex flex-col items-center justify-center bg-slate-900 rounded-3xl z-50 transition-opacity duration-500">
          <div className="relative w-16 h-16 mb-4">
            <div className="absolute inset-0 border-4 border-cyan-500/20 rounded-full"></div>
            <div className="absolute inset-0 border-4 border-cyan-400 border-t-transparent rounded-full animate-spin"></div>
            <div className="absolute inset-0 flex items-center justify-center">
              <span className="text-[10px] font-mono text-cyan-400 font-bold">{progress}%</span>
            </div>
          </div>
          <span className="text-slate-300 font-mono text-sm tracking-widest uppercase">Avvio 3D...</span>
        </div>
      )}

      {/* <model-viewer> configurato per l'e-commerce */}
      <model-viewer
        ref={viewerRef}
        src={MODEL_URL}
        camera-controls
        auto-rotate
        rotation-per-second="15deg"
        shadow-intensity="1"
        shadow-softness="1"
        camera-orbit="45deg 75deg 5m"
        min-camera-orbit="auto 0deg auto"
        max-camera-orbit="auto 90deg auto"
        style={{ width: '100%', height: '100%', backgroundColor: 'transparent' }}
        alt="Modello 3D interattivo ABYSS 350"
      ></model-viewer>
    </div>
  );
}

