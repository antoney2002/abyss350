function CheckoutModal({ isOpen, onClose }) {
  const [step, setStep] = useState('shipping'); // 'shipping' | 'payment' | 'processing' | 'success'
  const [formData, setFormData] = useState({
    fullName: '', email: '', phone: '', address: '', city: '', cap: '',
    cardNumber: '', expiry: '', cvc: '', paymentMethod: 'card'
  });
  const [errors, setErrors] = useState({});

  if (!isOpen) return null;

  const handleInputChange = (e) => {
    setFormData({ ...formData, [e.target.name]: e.target.value });
    if (errors[e.target.name]) setErrors({ ...errors, [e.target.name]: '' });
  };

  const validateShipping = () => {
    const errs = {};
    if (!formData.fullName.trim()) errs.fullName = 'Obbligatorio';
    if (!formData.email.includes('@')) errs.email = 'Email non valida';
    if (!formData.phone.trim()) errs.phone = 'Obbligatorio';
    if (!formData.address.trim()) errs.address = 'Obbligatorio';
    if (!formData.city.trim()) errs.city = 'Obbligatorio';
    if (!formData.cap.trim()) errs.cap = 'Obbligatorio';
    setErrors(errs);
    return Object.keys(errs).length === 0;
  };

  const validatePayment = () => {
    if (formData.paymentMethod === 'paypal') return true;
    const errs = {};
    if (!formData.cardNumber.trim()) errs.cardNumber = 'Inserire numero carta';
    if (!formData.expiry.trim()) errs.expiry = 'Inserire scadenza';
    if (!formData.cvc.trim()) errs.cvc = 'Inserire CVC';
    setErrors(errs);
    return Object.keys(errs).length === 0;
  };

  const proceedToPayment = (e) => {
    e.preventDefault();
    if (validateShipping()) setStep('payment');
  };

  const handleSubmitFinal = (e) => {
    e.preventDefault();
    if (formData.paymentMethod === 'card' && !validatePayment()) return;
    
    setStep('processing');
    setTimeout(() => setStep('success'), 2500);
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md overflow-y-auto">
      <div className="relative w-full max-w-xl rounded-3xl bg-slate-900 border border-cyan-500/40 shadow-2xl p-6 sm:p-8 text-left my-8">
        
        <button onClick={onClose} className="absolute top-5 right-5 p-2 rounded-xl text-slate-400 hover:text-white bg-slate-800/60 transition-colors">
          <X className="w-5 h-5" />
        </button>

        {/* STEP 1: SPEDIZIONE */}
        {step === 'shipping' && (
          <form onSubmit={proceedToPayment} className="space-y-5 animate-in fade-in slide-in-from-bottom-4">
            <div>
              <span className="text-xs font-mono font-bold text-lime-400 uppercase">Checkout Sicuro 1/2</span>
              <h3 className="text-2xl font-black text-white mt-1">Dati Spedizione</h3>
            </div>

            <div className="p-4 rounded-2xl bg-slate-950 border border-slate-800 flex justify-between items-center text-sm">
              <div>
                <span className="text-slate-200 font-bold block">1x Kit ABYSS 350 Completo</span>
                <span className="text-emerald-400 text-xs font-mono">Spedizione Express Inclusa</span>
              </div>
              <span className="text-xl font-black text-white">€{PRODUCT_PRICE.toFixed(2).replace('.', ',')}</span>
            </div>

            <div className="space-y-4 pt-2">
              <div>
                <label className="block text-xs font-semibold text-slate-300 mb-1.5">Nome e Cognome</label>
                <input type="text" name="fullName" value={formData.fullName} onChange={handleInputChange} className="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white text-sm focus:border-cyan-400 outline-none transition-colors" />
                {errors.fullName && <p className="text-[11px] text-red-400 mt-1">{errors.fullName}</p>}
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
