                <input type="text" name="address" value={formData.address} onChange={handleInputChange} className="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white text-sm focus:border-cyan-400 outline-none transition-colors" />
                {errors.address && <p className="text-[11px] text-red-400 mt-1">{errors.address}</p>}
              </div>

              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-xs font-semibold text-slate-300 mb-1.5">Città</label>
                  <input type="text" name="city" value={formData.city} onChange={handleInputChange} className="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white text-sm focus:border-cyan-400 outline-none transition-colors" />
                  {errors.city && <p className="text-[11px] text-red-400 mt-1">{errors.city}</p>}
                </div>
                <div>
                  <label className="block text-xs font-semibold text-slate-300 mb-1.5">CAP</label>
                  <input type="text" name="cap" value={formData.cap} onChange={handleInputChange} className="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white text-sm focus:border-cyan-400 outline-none transition-colors" />
                  {errors.cap && <p className="text-[11px] text-red-400 mt-1">{errors.cap}</p>}
                </div>
              </div>
            </div>

            <button type="submit" className="w-full flex items-center justify-center gap-2 py-4 rounded-2xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black text-base uppercase tracking-wider shadow-xl transition-colors mt-6">
              Vai al Pagamento <ArrowRight className="w-5 h-5" />
            </button>
          </form>
        )}

        {/* STEP 2: PAGAMENTO */}
        {step === 'payment' && (
          <form onSubmit={handleSubmitFinal} className="space-y-5 animate-in fade-in slide-in-from-right-4">
            <div>
              <span className="text-xs font-mono font-bold text-emerald-400 uppercase">Checkout Sicuro 2/2</span>
              <h3 className="text-2xl font-black text-white mt-1">Metodo di Pagamento</h3>
            </div>

            <div className="flex gap-4">
              <label className={`flex-1 flex flex-col items-center justify-center p-4 rounded-xl border-2 cursor-pointer transition-colors ${formData.paymentMethod === 'card' ? 'border-cyan-500 bg-cyan-500/10' : 'border-slate-800 bg-slate-950 hover:bg-slate-900'}`}>
                <input type="radio" name="paymentMethod" value="card" checked={formData.paymentMethod === 'card'} onChange={handleInputChange} className="hidden" />
                <CreditCard className={`w-8 h-8 mb-2 ${formData.paymentMethod === 'card' ? 'text-cyan-400' : 'text-slate-500'}`} />
                <span className={`text-sm font-bold ${formData.paymentMethod === 'card' ? 'text-cyan-400' : 'text-slate-400'}`}>Carta</span>
              </label>
              
              <label className={`flex-1 flex flex-col items-center justify-center p-4 rounded-xl border-2 cursor-pointer transition-colors ${formData.paymentMethod === 'paypal' ? 'border-blue-500 bg-blue-500/10' : 'border-slate-800 bg-slate-950 hover:bg-slate-900'}`}>
                <input type="radio" name="paymentMethod" value="paypal" checked={formData.paymentMethod === 'paypal'} onChange={handleInputChange} className="hidden" />
                {/* Simulated PayPal Icon */}
                <div className={`text-2xl font-black italic mb-1 ${formData.paymentMethod === 'paypal' ? 'text-blue-400' : 'text-slate-500'}`}>
                  Pay<span className={formData.paymentMethod === 'paypal' ? 'text-blue-300' : 'text-slate-600'}>Pal</span>
                </div>
                <span className={`text-sm font-bold ${formData.paymentMethod === 'paypal' ? 'text-blue-400' : 'text-slate-400'}`}>PayPal</span>
              </label>
            </div>

            {formData.paymentMethod === 'card' && (
              <div className="space-y-4 p-5 rounded-2xl bg-slate-950 border border-slate-800">
                <div className="flex items-center justify-between mb-2">
                  <span className="text-sm font-semibold text-slate-300">Dati della Carta</span>
                  <Lock className="w-4 h-4 text-emerald-400" />
                </div>
                <div>
                  <input type="text" name="cardNumber" value={formData.cardNumber} onChange={handleInputChange} placeholder="Numero Carta (0000 0000 0000 0000)" className="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm focus:border-cyan-400 outline-none" />
                  {errors.cardNumber && <p className="text-[11px] text-red-400 mt-1">{errors.cardNumber}</p>}
                </div>
                <div className="grid grid-cols-2 gap-4">
                  <div>
                    <input type="text" name="expiry" value={formData.expiry} onChange={handleInputChange} placeholder="Scadenza (MM/AA)" className="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm focus:border-cyan-400 outline-none" />
                    {errors.expiry && <p className="text-[11px] text-red-400 mt-1">{errors.expiry}</p>}
                  </div>
                  <div>
                    <input type="text" name="cvc" value={formData.cvc} onChange={handleInputChange} placeholder="CVC (123)" className="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm focus:border-cyan-400 outline-none" />
                    {errors.cvc && <p className="text-[11px] text-red-400 mt-1">{errors.cvc}</p>}
                  </div>
                </div>
              </div>
            )}

            {formData.paymentMethod === 'paypal' && (
              <div className="p-5 rounded-2xl bg-blue-950/20 border border-blue-900/50 text-center">
                <p className="text-sm text-slate-300">Sarai reindirizzato in sicurezza sui server PayPal per completare la transazione.</p>
              </div>
            )}

            <div className="flex gap-3 mt-6">
              <button type="button" onClick={() => setStep('shipping')} className="px-5 py-4 rounded-2xl bg-slate-800 hover:bg-slate-700 text-white font-bold transition-colors">
                Indietro
              </button>
              <button type="submit" className="flex-1 flex items-center justify-center gap-2 py-4 rounded-2xl bg-gradient-to-r from-lime-500 to-emerald-500 text-slate-950 font-black text-base uppercase tracking-wider shadow-xl transition-transform hover:scale-105">
                <Lock className="w-4 h-4" /> Paga €{PRODUCT_PRICE.toFixed(2).replace('.', ',')}
              </button>
            </div>
          </form>
        )}

        {/* STEP 3: ELABORAZIONE */}
        {step === 'processing' && (
          <div className="py-20 text-center flex flex-col items-center animate-in zoom-in-95">
            <div className="w-16 h-16 border-4 border-cyan-500 border-t-transparent rounded-full animate-spin mb-6" />
            <h4 className="text-xl font-bold text-white mb-2">Elaborazione in corso...</h4>
            <p className="text-sm text-slate-400">Connessione sicura al gateway di pagamento</p>
          </div>
        )}

        {/* STEP 4: SUCCESSO */}
        {step === 'success' && (
          <div className="py-16 text-center animate-in zoom-in-95 duration-500">
            <div className="w-20 h-20 rounded-full bg-emerald-500/20 border-2 border-emerald-500 text-emerald-400 flex items-center justify-center mx-auto mb-6 shadow-[0_0_30px_rgba(16,185,129,0.3)]">
              <Check className="w-10 h-10" />
            </div>
            <h4 className="text-2xl font-black text-white mb-2">Ordine Confermato!</h4>
            <p className="text-sm text-slate-300 max-w-sm mx-auto mb-6">
              Grazie <strong>{formData.fullName}</strong>. Ti abbiamo inviato una mail di riepilogo a <strong>{formData.email}</strong>.
            </p>
            <button onClick={onClose} className="px-8 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold transition-colors">
              Torna al Sito
            </button>
          </div>
        )}
      </div>
    </div>
  );
}

export default function App() {
  const [isCheckoutOpen, setIsCheckoutOpen] = useState(false);

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 font-sans selection:bg-cyan-500 selection:text-slate-950 scroll-smooth">
      <Header onOrderClick={() => setIsCheckoutOpen(true)} />
      <TrustBar />
      <HeroSection onOrderClick={() => setIsCheckoutOpen(true)} />
      <FeaturesSection />
      
      {/* SEZIONE PACK RIPRISTINATA */}
      <IncludedKitSection />
      
      <ContactSection />
      
      <footer className="bg-[#010408] border-t border-slate-900 py-10 text-center">
        <p className="text-xs text-slate-500 max-w-md mx-auto">
          © {new Date().getFullYear()} ABYSS Nautica Sports. Tutti i diritti riservati. <br/>
          Prezzo fisso di vendita al pubblico: €249,90 IVA inclusa.
        </p>
      </footer>

      {/* MODAL CHECKOUT MIGLIORATO CON PAGAMENTO */}
      <CheckoutModal 
        isOpen={isCheckoutOpen} 
        onClose={() => setIsCheckoutOpen(false)} 
      />
    </div>
  );
}
